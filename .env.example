# Copy to apps/api/.env (runtime) and fill real values. NEVER commit .env.
# The API connects as the restricted role qlhs_app (append-only); migrations
# run as the owner qlhs.

# ── API ──
PORT=3000

# ── PostgreSQL 18 (Prisma) ──
# In docker-compose the host is `postgres`; for local dev use `localhost`.
DATABASE_URL=postgresql://qlhs_app:qlhs_app@localhost:5432/qlhs?schema=public

# ── PMH ID SSO (OIDC) ──
# Leave OIDC_ISSUER blank to run on dev-login; fill it to enable real OIDC.
# All URLs are on the WEB origin (same-origin; /api is proxied to the API).
OIDC_ISSUER=
OIDC_CLIENT_ID=project_qlhs
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
WEB_ORIGIN=http://localhost:5173

# Optional: SSO emails auto-granted Admin on login (comma-separated).
QLHS_ADMIN_EMAILS=

# Optional: PMH ID offboarding webhook (POST /api/webhooks/pmh-id). Shared HMAC
# secret; PMH ID signs each delivery (x-pmh-signature = HMAC-SHA256 of the body).
# Blank = webhook disabled (all deliveries rejected). Kills sessions instantly on
# user.locked/deleted/password_changed — a 2nd revocation channel beyond BCL.
PMH_WEBHOOK_SECRET=

# ── Local (non-SSO) SA — break-glass admin, seeded on boot ──
# Set both to enable a local admin login (web: "Đăng nhập Admin nội bộ").
# Works even when PMH ID is unreachable. Leave blank to disable.
QLHS_LOCAL_ADMIN_EMAIL=admin.ssa@local.com
QLHS_LOCAL_ADMIN_PASSWORD=

# ── SMTP ──
# DEV: point at the Mailpit catch-all (host localhost:11025, UI :18025) so no real
#      mail leaves the machine.
# PROD: set the company's REAL mail relay here — this is the ONLY thing that makes
#       notifications actually reach users. Mailpit does NOT run in prod. The relay
#       host must be reachable from the api container (a hostname/IP, not localhost).
#   e.g.  SMTP_HOST=smtp.pmh.com.vn   SMTP_PORT=587
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_FROM=qlhs@pmh.com.vn
# Optional (dev): SMTP_SECURE=true for TLS, SMTP_USER/SMTP_PASS for auth relays.

# ── Config encryption (SMTP password) ──
# Required ONLY to save an SMTP password from the admin UI (Cấu hình › Email):
# the password is AES-256-GCM encrypted at rest with SHA-256(CONFIG_ENC_KEY).
# Any string works as the key; set a strong random value in prod and NEVER rotate
# it without re-entering the SMTP password (old ciphertext won't decrypt).
CONFIG_ENC_KEY=

# ── Backup ──
# Đường dẫn HOST chứa dump DB (bind-mount vào pg-backup:/backups). Tương đối theo
# thư mục dự án, hoặc TUYỆT ĐỐI để đẩy sang ổ khác (vd /mnt/backup/qlhs, hoặc trên
# Windows: D:/backups/qlhs). Bỏ trống = ./data-backups. Đặt trong .env (gốc dự án).
BACKUP_PATH=./data-backups
