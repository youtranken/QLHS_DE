{
  "name": "qlhs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run && pnpm --filter @qlhs/web test",
    "test:api": "vitest run",
    "test:web": "pnpm --filter @qlhs/web test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/contracts/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@swc/core": "^1.10.1",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "typescript": "~5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
